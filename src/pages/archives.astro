---
import Highlight from '@/components/Highlight.astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { getOldestPosts } from '@/utils/content'
import { TimelineProgress } from '@/components/TimelineProgress'
import { PostCarousel } from '@/components/PostCarousel'

const oldestPosts = await getOldestPosts()
---

<PageLayout title="归档">
  <div class="max-w-[1100px] mx-auto px-4 py-16">
    <div class="grid lg:grid-cols-[1fr_auto] gap-10 items-start">
      <!-- 左侧：统计信息 -->
      <div>
        <header class="space-y-4">
          <h1 class="text-4xl font-bold">
            <Highlight>归档</Highlight>
          </h1>
          <p>共产出 {oldestPosts.length} 篇文章，再接再厉。</p>
          <hr class="w-[100px] border-primary" />
          <TimelineProgress client:only="react" pathname={Astro.url.pathname} />
        </header>
      </div>

      <!-- 右侧：摩天轮文章轮播 -->
      {
        oldestPosts.length > 0 && (
          <div class="lg:sticky lg:top-24 flex items-center justify-center min-w-[360px]">
            <PostCarousel posts={oldestPosts} client:only="react" />
          </div>
        )
      }
    </div>
  </div>
</PageLayout>
