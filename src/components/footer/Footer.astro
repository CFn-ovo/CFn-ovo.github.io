---
// 导入工具函数：获取所有博文的总字数
import { getAllPostsWordCount } from '@/utils/content'
// 导入运行天数组件（React 客户端组件）
import { RunningDays } from './RunningDays'
// 导入自定义链接组件
import Link from './Link.astro'

// 异步获取所有博文的总字数（单位：汉字/字符）
const wordCount = await getAllPostsWordCount()

// 将字数转换为万字单位（w），保留一位小数
const wordCountStr = (wordCount / 10000).toFixed(1) + 'w'
---

<!-- 页脚容器：相对定位，z-index 保证层级，内边距，上边框，文字颜色和大小 -->
<footer class="relative z-1 py-8 px-4 md:px-8 border-t border-primary text-secondary text-sm">
  <!-- 居中的内容区域，垂直间距 -->
  <div class="text-center space-y-2">
    <!-- 第一行：技术栈和主题设计信息 -->
    <div>
      Powered by 
      <Link href="https://astro.build/"> Astro </Link>
      & Designed by 
      <Link href="https://github.com/cfn-ovo/cfn-ovo.github.io"> CFn-ovo</Link>
    </div>
    <!-- 第三行：运行天数和总字数 -->
    <div>
      <!-- React 客户端组件：动态计算并显示网站已运行天数 -->
      <RunningDays client:only="react" />
      <!-- 分隔符，半透明且禁止选中 -->
      <span class="select-none opacity-50">|</span>
      <!-- 显示总字数（万字单位） -->
      <span>  {wordCountStr}字</span>
    </div>
  </div>
</footer>