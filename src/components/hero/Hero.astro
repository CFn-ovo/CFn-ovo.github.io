---
import { hero } from '@/config.json'
import { SocialList } from './SocialList'
import Highlight from '@/components/Highlight.astro'
---

<div id="hero" class="lg:-mt-16 lg:h-dvh lg:min-h-[720px] relative overflow-hidden bg-gray-100 dark:bg-gray-900">
  <!-- 背景装饰：柔光斑点 -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-1/4 left-1/4 size-96 bg-violet-300/30 dark:bg-violet-600/10 rounded-full blur-[128px]"></div>
    <div class="absolute bottom-1/4 right-1/4 size-80 bg-sky-300/30 dark:bg-sky-600/10 rounded-full blur-[96px]"></div>
  </div>

  <!-- 主内容层：居中 -->
  <div
    class="relative max-w-[1300px] mx-auto h-full px-4 flex flex-col items-center justify-center text-center"
  >
    <!-- 玻璃卡片 -->
    <div class="max-w-[800px] w-full backdrop-blur-2xl bg-white/20 dark:bg-white/[0.04] rounded-[64px] border border-white/20 dark:border-white/[0.06] shadow-2xl shadow-black/5 dark:shadow-black/20 px-10 py-14 lg:px-16 lg:py-20">
      <h1 class="text-3xl lg:text-5xl font-bold text-gray-900 dark:text-white text-balance">
        Hi, I'm <Highlight class="font-bold">{hero.name}</Highlight>👋<br />{hero.bio}
      </h1>
      <div class="text-sm lg:text-base text-gray-500 dark:text-white/60 mt-4">{hero.description}</div>
      <SocialList className="mt-[60px] flex justify-center" client:load />
    </div>

    <!-- 底部格言 + 箭头 -->
    <div class="absolute bottom-10 inset-x-0 flex flex-col items-center">
      <p class="text-lg md:text-xl text-center text-balance font-medium glow-text px-4 max-w-3xl">
        {hero.yiyan}
      </p>
      <div class="mt-7 text-xl animate-bounce text-gray-400 dark:text-white/60 cursor-pointer scroll-arrow">
        <i class="iconfont icon-down"></i>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelector('.scroll-arrow')?.addEventListener('click', () => {
    const hero = document.getElementById('hero');
    if (hero) {
      window.scrollTo({ top: hero.offsetHeight, behavior: 'smooth' });
    }
  });
</script>
